{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.dev/schemas/external-ci-evidence-v1.schema.json",
  "title": "ExternalCIEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "candidate_id",
    "candidate_manifest_sha256",
    "workflow_sha256",
    "matrix",
    "jobs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_id": {
      "type": "string",
      "pattern": "^v1-rc-[a-z0-9]+-[0-9]{8}T[0-9]{6}Z$"
    },
    "candidate_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "workflow_sha256": { "$ref": "#/$defs/sha256" },
    "matrix": {
      "type": "array",
      "items": { "enum": ["windows", "ubuntu"] },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "jobs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+"
        },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "conclusion"],
      "properties": {
        "command": { "const": "pnpm e2e" },
        "exit_code": { "const": 0 },
        "conclusion": { "const": "success" }
      }
    },
    "quality_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "conclusion"],
      "properties": {
        "command": {
          "enum": [
            "uv sync --frozen",
            "uv run ruff check .",
            "uv run mypy apps/api/src",
            "uv run pytest",
            "pnpm install --frozen-lockfile",
            "pnpm check"
          ]
        },
        "exit_code": { "const": 0 },
        "conclusion": { "const": "success" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "job_id",
        "conclusion",
        "e2e",
        "quality",
        "provider",
        "repository",
        "workflow_run_url",
        "job_url",
        "run_id",
        "started_at",
        "finished_at",
        "artifacts",
        "logs",
        "reports",
        "traces"
      ],
      "properties": {
        "platform": { "enum": ["windows", "ubuntu"] },
        "job_id": { "type": "string", "minLength": 1 },
        "conclusion": { "const": "success" },
        "e2e": { "$ref": "#/$defs/e2e" },
        "quality": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/quality_command" }
        },
        "provider": { "const": "github-actions" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "workflow_run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "job_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/job/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hash_ref" }
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hash_ref" }
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hash_ref" }
        },
        "traces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hash_ref" }
        }
      }
    }
  }
}
