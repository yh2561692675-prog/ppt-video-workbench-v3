{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/provider-descriptor-v1.schema.json",
  "title": "ProviderDescriptorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "kind", "display_name", "adapter_version", "capabilities", "trust"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "kind": {"type": "string", "enum": ["llm", "tts", "asr", "ocr", "avatar", "renderer"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"}},
    "regions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,32}$"}},
    "trust": {"type": "string", "enum": ["builtin_signed", "builtin_local_process"]},
    "credential_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "data_policy": {"type": "string", "enum": ["local_only", "user_content_required", "metadata_only"]}
  }
}

