{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.dev/schemas/debug-candidate-v1.schema.json",
  "title": "CandidateManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "generated_at", "source", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^v1-rc-[a-z0-9]+-[0-9]{8}T[0-9]{6}Z$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string", "minLength": 1},
        "dirty": {"const": false}
      }
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRef"}},
    "installer": {"$ref": "#/$defs/fileRef"},
    "runtime": {"type": "object"},
    "features": {"type": "object"}
  },
  "$defs": {
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/|\\\\)\\.\\.(/|\\\\|$)).+"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
