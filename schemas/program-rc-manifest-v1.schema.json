{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/program-rc-manifest-v1.schema.json",
  "title": "ProgramRcManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "status", "source", "ordered_tasks", "stop_points", "runtime_evidence", "blockers", "freeze_policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["static_candidate_blocked", "static_candidate_ready_for_runtime_gates"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "dirty", "lock_hashes"],
      "properties": {
        "git_commit": { "type": "string", "minLength": 7 },
        "dirty": { "type": "boolean" },
        "lock_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "ordered_tasks": { "type": "array", "minItems": 14, "items": { "type": "string" } },
    "stop_points": {
      "type": "object",
      "minProperties": 14,
      "additionalProperties": false,
      "patternProperties": {
        "^(?:A20|A21|A22|A23|A24|B20|B21|B22|B23|C20|C21|C22|A30|B30)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "source_commit", "title"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_commit": { "type": "string", "minLength": 7 },
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runtime_evidence": { "type": "object", "additionalProperties": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "freeze_policy": { "type": "string", "minLength": 1 }
  }
}
