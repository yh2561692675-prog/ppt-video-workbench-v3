{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/update-metadata-v1.schema.json",
  "title": "SignedUpdateMetadataV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signatures"],
  "properties": {
    "signed": {
      "type": "object",
      "required": ["role", "version", "expires_at"],
      "properties": {
        "role": { "enum": ["root", "timestamp", "snapshot", "targets"] },
        "version": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "threshold": { "type": "integer", "minimum": 1 },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/key" } },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } }
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "signature"],
        "properties": {
          "key_id": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "public_key"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "public_key": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "published_at", "expires_at", "size", "sha256", "url"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "min_supported_version": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "runtime_manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
