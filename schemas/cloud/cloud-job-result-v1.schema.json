{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.invalid/schemas/cloud-job-result-v1.schema.json",
  "title": "CloudJobResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "executor_id", "status", "result_schema_version", "result", "result_sha256", "output_refs", "output_media_types", "fingerprints"],
  "properties": {
    "attempt_id": { "type": "string", "format": "uuid" },
    "executor_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "result_schema_version": { "const": 1 },
    "result": { "type": "object", "additionalProperties": true },
    "result_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "output_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^(artifact://)?sha256:[0-9a-f]{64}$"
      }
    },
    "output_media_types": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": { "pattern": "^(artifact://)?sha256:[0-9a-f]{64}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "fingerprints": {
      "type": "object",
      "required": ["provider_policy", "runtime", "platform", "input"],
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
      "properties": {
        "provider_policy": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runtime": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platform": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "input": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  }
}
