{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.invalid/schemas/platform-release-evidence-v1.schema.json",
  "title": "PlatformReleaseEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "platform",
    "runner_os",
    "runner_arch",
    "real_runner",
    "status",
    "evidence_id",
    "captured_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {
      "type": "string",
      "enum": ["install", "upgrade", "rollback", "uninstall", "runtime", "signature"]
    },
    "platform": {"type": "string", "enum": ["windows", "macos", "linux"]},
    "runner_os": {"type": "string", "minLength": 1, "maxLength": 200},
    "runner_arch": {"type": "string", "minLength": 1, "maxLength": 64},
    "real_runner": {"const": true},
    "status": {"const": "passed"},
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$"
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "verified", "certificate_subject", "artifact_sha256"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 3, "maxLength": 100},
        "verified": {"const": true},
        "certificate_subject": {"type": "string", "minLength": 1, "maxLength": 500},
        "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "media_exports"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_exports": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "duration_ms"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 100},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "duration_ms": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_type": {"const": "signature"}}},
      "then": {"required": ["signature"]}
    },
    {
      "if": {"properties": {"evidence_type": {"const": "runtime"}}},
      "then": {"required": ["runtime"]}
    }
  ]
}
