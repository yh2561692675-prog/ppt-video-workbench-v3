{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.dev/schemas/debug-signoff-v1.schema.json",
  "title": "DebugSignoffV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "role",
    "reviewer",
    "decision",
    "signed_at",
    "evidence_hashes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "pattern": "^v1-rc-[a-z0-9]+-[0-9]{8}T[0-9]{6}Z$" },
    "role": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "rejected", "blocked"] },
    "signed_at": { "type": "string", "format": "date-time" },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "notes": { "type": "string" }
  }
}
