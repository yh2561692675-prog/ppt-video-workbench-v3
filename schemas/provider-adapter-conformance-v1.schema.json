{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-adapter-conformance-v1",
  "title": "Provider adapter conformance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "descriptor_fingerprint", "status", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "descriptor_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tested_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "degraded"]},
    "checks": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"enum": ["pass", "fail", "skip"]}},
    "error_codes": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "sanitized": {"type": "boolean"},
    "fake_provider": {"type": "boolean"}
  }
}
