{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-cost-reservation-v1",
  "title": "Provider cost reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservation_id", "operation_id", "provider_id", "capability_id", "scopes", "reserved_cost_minor", "price_book_version", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "reservation_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
    "reserved_cost_minor": {"type": "integer", "minimum": 0},
    "committed_cost_minor": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "price_book_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": ["reserved", "committed", "released", "unknown"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
