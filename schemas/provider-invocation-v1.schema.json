{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/provider-invocation-v1.schema.json",
  "title": "ProviderInvocationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "operation", "context", "input_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "operation": {"type": "string", "enum": ["probe", "estimate", "invoke", "cancel"]},
    "context": {"$ref": "operation-context-v1.schema.json"},
    "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_media_type": {"type": "string", "maxLength": 255},
    "requested_capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"}
  }
}

