{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.dev/schemas/debug-scenario-v1.schema.json",
  "title": "DebugScenarioV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "matrix",
    "risk",
    "platform",
    "owner",
    "steps",
    "destructive",
    "paid",
    "manual"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario_id": { "type": "string", "pattern": "^DBG-[a-z0-9]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "matrix": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["P0", "P1", "P2", "P3"] },
    "platform": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "feature_flags": { "type": "array", "items": { "type": "string" } },
    "fixture": { "type": "string" },
    "authorization_scope": { "type": "string" },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "destructive": { "type": "boolean" },
    "paid": { "type": "boolean" },
    "manual": { "type": "boolean" },
    "resources": { "type": "array", "items": { "type": "string" } },
    "cleanup": { "type": "array", "items": { "type": "string" } }
  }
}
