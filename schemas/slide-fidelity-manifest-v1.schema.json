{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/slide-fidelity-manifest-v1.schema.json",
  "title": "SlideFidelityManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_path",
    "source_hash",
    "pages",
    "capability",
    "scanner_version",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_path": { "type": "string" },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "capability": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "scanner_version": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "page_index", "level", "renderer", "scene", "issues", "input_hash"],
      "properties": {
        "page_id": { "type": "string", "format": "uuid" },
        "page_index": { "type": "integer", "minimum": 1 },
        "level": { "enum": ["F0", "F1", "F2", "F3"] },
        "renderer": { "enum": ["python", "libreoffice", "powerpoint", "native_capture"] },
        "scene": { "type": "object" },
        "preview_path": { "type": ["string", "null"] },
        "issues": { "type": "array" },
        "downgrade_reason": { "type": ["string", "null"] },
        "input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
