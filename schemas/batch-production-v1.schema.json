{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.local/schemas/batch-production-v1.schema.json",
  "title": "Batch Production v1",
  "type": "object",
  "required": [
    "version",
    "revision",
    "batch_id",
    "project_id",
    "created_at",
    "status",
    "night_queue",
    "resource_limits",
    "items",
    "content_hash"
  ],
  "properties": {
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "batch_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string" },
    "status": { "enum": ["queued", "running", "succeeded", "partial", "failed", "cancelled"] },
    "night_queue": { "type": "boolean" },
    "resource_limits": { "$ref": "#/$defs/resources" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "required": ["max_parallel", "cpu_cores", "memory_mb", "gpu_slots", "per_job_memory_mb"],
      "properties": {
        "max_parallel": { "type": "integer", "minimum": 1 },
        "cpu_cores": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 512 },
        "gpu_slots": { "type": "integer", "minimum": 0 },
        "per_job_memory_mb": { "type": "integer", "minimum": 256 }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "preset_id",
        "page_id",
        "priority",
        "dependencies",
        "resource_cpu",
        "resource_memory_mb",
        "resource_gpu",
        "status",
        "job_id",
        "attempts",
        "error"
      ],
      "properties": {
        "item_id": { "type": "string", "format": "uuid" },
        "preset_id": { "type": "string" },
        "page_id": { "type": ["string", "null"], "format": "uuid" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "dependencies": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "resource_cpu": { "type": "integer", "minimum": 1 },
        "resource_memory_mb": { "type": "integer", "minimum": 256 },
        "resource_gpu": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": ["queued", "dispatched", "running", "succeeded", "failed", "cancelled"]
        },
        "job_id": { "type": ["string", "null"], "format": "uuid" },
        "attempts": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
