{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-video-workbench.dev/schemas/debug-run-v1.schema.json",
  "title": "DebugRunV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_id", "matrix", "started_at", "attempt", "status", "artifacts", "orphan_processes"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string", "minLength": 4},
    "candidate_id": {"type": "string", "pattern": "^v1-rc-[a-z0-9]+-[0-9]{8}T[0-9]{6}Z$"},
    "matrix": {"type": "string", "minLength": 1}, "platform": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 1}, "status": {"enum": ["planned", "running", "passed", "failed", "blocked", "interrupted"]},
    "artifacts": {"type": "array", "items": {"type": "object"}}, "orphan_processes": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "environment": {"type": "object"}
  }
}
