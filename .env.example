# PPT Video Workbench does not require external API credentials for its local-only workflow.
# Copy this file to .env only if your local launcher loads environment files.

WORKBENCH_WORKSPACE=workspace-data
WORKBENCH_CACHE_ROOT=cache
WORKBENCH_OUTPUT_ROOT=output

# Save optional LLM and HeyGen credentials through the application settings UI.
# Never add real API keys, tokens, passwords, or credential-bearing URLs here.
