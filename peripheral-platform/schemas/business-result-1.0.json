{
  "$defs": {
    "BusinessArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "logical_name": {
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$",
          "title": "Logical Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "logical_name",
        "kind",
        "size_bytes",
        "sha256"
      ],
      "title": "BusinessArtifact",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BusinessArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "job_type": {
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
      "title": "Job Type",
      "type": "string"
    },
    "module_id": {
      "enum": [
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12"
      ],
      "title": "Module Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "project_revision": {
      "minimum": 1,
      "title": "Project Revision",
      "type": "integer"
    },
    "result_type": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Result Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "job_type",
    "project_id",
    "project_revision",
    "input_fingerprint",
    "cache_key",
    "result_type",
    "payload"
  ],
  "title": "BusinessResultManifest",
  "type": "object"
}
